DATABASE_URI=file:./data/softmarket.db
PAYLOAD_SECRET=CHANGE_RANDOM_SECRET
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3100

UPLOADS_DIR=./uploads

SMTP_HOST=CHANGE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_SMTP_USER
SMTP_PASSWORD=CHANGE_SMTP_PASSWORD
SMTP_FROM=CHANGE_SMTP_FROM

FORM_NOTIFICATION_EMAIL=
# Same random secret (at least 32 characters) in the Caddy and app environments.
FORM_PROXY_SECRET=CHANGE_RANDOM_PROXY_SECRET

TURNSTILE_SECRET_KEY=CHANGE_TURNSTILE_SECRET_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_TURNSTILE_SITE_KEY
DOMAIN=CHANGE_DOMAIN

DEPLOY_HOST=
LITESTREAM_BUCKET=
LITESTREAM_PATH=softmarket
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Optional, public Cloudflare Web Analytics site token (manual beacon embedding).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# CSP rollout: defaults to Report-Only; set false to disable or true to enforce.
CSP_ENABLED=true
CSP_ENFORCE=false
# Optional isolated production build directory; default .next (use .next-prod with dev running).
# NEXT_DIST_DIR=.next-prod

# Payments (P1 core; not wired to routes yet). Off unless PAYMENTS_ENABLED=true. Never commit real values.
PAYMENTS_ENABLED=false
# iyzico: primary provider for TRY/USD/EUR. Base URL: https://sandbox-api.iyzipay.com or https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
# Stripe: off by default (Türkiye is not a Stripe-supported country). Only with a foreign legal entity.
PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_STRIPE_CURRENCIES=USD,EUR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
