{
  "name": "softmarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12 <13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "playwright test -c playwright.isolated.config.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "node --import tsx node_modules/payload/bin.js --disable-transpile migrate:create",
    "migrate:status": "payload migrate:status",
    "seed": "pnpm ensure-forms && pnpm content:import",
    "ensure-forms": "tsx scripts/ensure-forms.ts",
    "search:reindex": "tsx scripts/reindex-search.ts",
    "content:import": "tsx scripts/content-import.ts",
    "media:regenerate": "tsx scripts/media-regenerate.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/plugin-search": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@tailwindcss/postcss": "^4.3.4",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "16.4.7",
    "geist": "^1.9.1",
    "graphql": "^16.8.1",
    "lucide-react": "^1.68.0",
    "next": "15.4.11",
    "next-intl": "^4.14.9",
    "payload": "3.93.0",
    "postcss": "^8.5.32",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "lighthouse": "^13.6.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
